gerar = comando =>
  | comando.tipo == "escreva" = [
    "console.log('"
    comando.argumento
    "')"
  ] * ""
  | comando.tipo == "saia" = [
    "process.exit("
    "" + comando.argumento
    ")"
  ] * ""
  | "throw new Error('Comando desconhecido.')"

nodejs = { comandos } =>
  | comandos[.] == 0 = ""
  | comandos[.] == 1 = gerar(comandos[0])
  | [
    nodejs({ comandos: [comandos[0]] })
    nodejs({ comandos: comandos[1:] })
  ] * ";"

nodejs